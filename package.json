{
  "name": "wayaquick-payment-sdk",
  "version": "2.0.0",
  "description": "Node.js/TypeScript client for the WayaPay Merchant API v2: collect, payout, accounts, identity, transactions.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "WAYA_LIVE=1 vitest run tests/live.test.ts",
    "sample": "tsx samples/usage.ts"
  },
  "keywords": [
    "wayapay",
    "wayaquick",
    "payments",
    "payout",
    "collect",
    "bvn",
    "nigeria",
    "fintech",
    "typescript"
  ],
  "author": "WayaPay",
  "repository": {
    "type": "git",
    "url": "https://github.com/WAYA-MULTI-LINK/WAYA-PAY-CHAT-2.0-NODEJS-LIBRARY"
  },
  "homepage": "https://github.com/WAYA-MULTI-LINK/WAYA-PAY-CHAT-2.0-NODEJS-LIBRARY/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/WAYA-MULTI-LINK/WAYA-PAY-CHAT-2.0-NODEJS-LIBRARY/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
